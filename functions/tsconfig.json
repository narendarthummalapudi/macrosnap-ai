{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "outDir": "./lib",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*",
    "firebase-applet-config.json"
  ]
}